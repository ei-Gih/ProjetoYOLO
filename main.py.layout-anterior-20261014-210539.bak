from pathlib import Path
from datetime import datetime
from tkinter import messagebox
import unicodedata

import customtkinter as ctk
import cv2
from PIL import Image
from ultralytics import YOLO

ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")
PASTA_PROJETO = Path(__file__).resolve().parent
CONFIANCA_MINIMA = 0.40
FUNDO, PAINEL, CARTAO = "#080F1C", "#101C2E", "#17263B"
BORDA, TEXTO, SUAVE = "#283A52", "#EEF4FF", "#94A9C4"
AZUL, VERDE, AMARELO, VERMELHO = "#4D8DFF", "#42D6A4", "#F5C166", "#FF7888"


def normalizar(nome):
    texto = unicodedata.normalize("NFKD", nome.lower())
    return "-".join("".join(c for c in texto if not unicodedata.combining(c)).replace("_", " ").replace("-", " ").split())


# Ajuste os aliases para os nomes exatos das classes do seu modelo treinado.
EPIS = {
    "Jaleco": {"jaleco", "lab-coat", "labcoat", "gown", "coat"},
    "Óculos de segurança": {"oculos", "oculos-de-seguranca", "goggles", "safety-glasses", "safety-goggles"},
    "Máscara": {"mascara", "mask", "face-mask", "medical-mask"},
    "Luvas": {"luva", "luvas", "glove", "gloves", "safety-gloves"},
    "Protetor auricular": {"protetor-auricular", "protetor-oricular", "ear-protection", "earmuffs", "ear-muffs", "earplug", "earplugs"},
    "Capacete": {"capacete", "helmet", "hardhat", "hard-hat", "safety-helmet"},
}
PESSOAS = {"person", "pessoa", "worker", "trabalhador"}


def avaliar_pessoas(deteccoes, classes_modelo):
    """Associa cada EPI a uma única pessoa; sobreposições ambíguas não liberam."""
    suportados = {epi: bool(aliases & classes_modelo) for epi, aliases in EPIS.items()}
    pessoas = [d for d in deteccoes if d[0] in PESSOAS]
    presentes = [set() for _ in pessoas]
    for nome, caixa in deteccoes:
        epi = next((e for e, aliases in EPIS.items() if nome in aliases), None)
        if epi is None:
            continue
        x1, y1, x2, y2 = caixa
        area = max(0, x2 - x1) * max(0, y2 - y1)
        candidatos = []
        for i, (_, (px1, py1, px2, py2)) in enumerate(pessoas):
            intersecao = max(0, min(x2, px2) - max(x1, px1)) * max(0, min(y2, py2) - max(y1, py1))
            if area > 0 and intersecao / area >= 0.70:
                candidatos.append(i)
        if len(candidatos) == 1:
            presentes[candidatos[0]].add(epi)
    return pessoas, presentes, suportados


class Aplicacao(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title("PYPROJECT | Central de segurança e EPIs")
        self.geometry("1440x920")
        self.minsize(1180, 820)
        self.configure(fg_color=FUNDO)
        self.camera = None
        self.after_id = None
        self.camera_ativa = False
        self.quantidade_alertas = 0
        self.estado_anterior = None
        self.eventos = []
        self.modelo = None
        self.protocol("WM_DELETE_WINDOW", self.fechar)
        self.criar_interface()
        self.after(100, self.carregar_modelo)

    def label(self, pai, texto, tamanho=13, cor=TEXTO, negrito=False, **kwargs):
        return ctk.CTkLabel(pai, text=texto, font=("Segoe UI", tamanho, "bold" if negrito else "normal"), text_color=cor, **kwargs)

    def painel(self, pai, **kwargs):
        return ctk.CTkFrame(pai, fg_color=PAINEL, border_color=BORDA, border_width=1, corner_radius=16, **kwargs)

    def criar_interface(self):
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)
        menu = ctk.CTkFrame(self, width=205, corner_radius=0, fg_color=PAINEL)
        menu.grid(row=0, column=0, sticky="nsew")
        menu.grid_propagate(False)
        self.label(menu, "PY", 34, AZUL, True).pack(anchor="w", padx=24, pady=(30, 0))
        self.label(menu, "PYPROJECT", 23, negrito=True).pack(anchor="w", padx=24)
        self.label(menu, "SEGURANÇA INTELIGENTE", 10, SUAVE).pack(anchor="w", padx=24, pady=(3, 40))
        ctk.CTkButton(menu, text="●   Central de monitoramento", height=46, fg_color="#203F6D", hover_color="#294F86", anchor="w", command=self.focus_set).pack(fill="x", padx=12)
        self.label(menu, "PROTOCOLO DE ACESSO", 10, SUAVE, True).pack(anchor="w", padx=24, pady=(35, 10))
        self.label(menu, "06 equipamentos\nobrigatórios por pessoa", 13, SUAVE, justify="left").pack(anchor="w", padx=24)
        self.label(menu, "PYPROJECT  /  VISÃO COMPUTACIONAL\nMonitoramento de proteção individual", 10, SUAVE, wraplength=170, justify="left").pack(side="bottom", padx=18, pady=25)

        corpo = ctk.CTkFrame(self, fg_color="transparent")
        corpo.grid(row=0, column=1, sticky="nsew", padx=24, pady=22)
        corpo.grid_columnconfigure(0, weight=3)
        corpo.grid_columnconfigure(1, weight=2, minsize=350)
        corpo.grid_rowconfigure(3, weight=1)
        topo = ctk.CTkFrame(corpo, fg_color="transparent")
        topo.grid(row=0, column=0, columnspan=2, sticky="ew")
        self.label(topo, "CENTRAL DE SEGURANÇA  /  TEMPO REAL", 10, AZUL, True).pack(anchor="w")
        self.label(topo, "Proteção em cada detalhe.", 28, negrito=True).pack(anchor="w", pady=(3, 0))
        self.label(topo, "Verificação visual dos equipamentos obrigatórios por pessoa detectada.", 13, SUAVE).pack(anchor="w", pady=(3, 14))
        self.modelo_label = self.label(corpo, "Carregando modelo de detecção...", 11, AMARELO, wraplength=950, justify="left")
        self.modelo_label.grid(row=1, column=0, columnspan=2, sticky="w", pady=(0, 15))
        indicadores = ctk.CTkFrame(corpo, fg_color="transparent")
        indicadores.grid(row=2, column=0, columnspan=2, sticky="ew", pady=(0, 18))
        indicadores.grid_columnconfigure((0, 1, 2, 3), weight=1)
        self.cards = {}
        for i, (chave, titulo, cor) in enumerate((("pessoas", "PESSOAS NA CENA", AZUL), ("liberadas", "EPIs CONFIRMADOS", VERDE), ("pendentes", "COM PENDÊNCIAS", AMARELO), ("alertas", "EVENTOS DE ATENÇÃO", VERMELHO))):
            card = self.painel(indicadores)
            card.grid(row=0, column=i, sticky="ew", padx=(0 if i == 0 else 6, 0 if i == 3 else 6))
            self.label(card, titulo, 10, SUAVE, True).pack(anchor="w", padx=15, pady=(14, 0))
            self.cards[chave] = self.label(card, "0", 30, cor, True)
            self.cards[chave].pack(anchor="w", padx=15, pady=(0, 12))

        camera = self.painel(corpo)
        camera.grid(row=3, column=0, sticky="nsew", padx=(0, 16))
        camera.grid_columnconfigure(0, weight=1)
        camera.grid_rowconfigure(1, weight=1)
        cab = ctk.CTkFrame(camera, fg_color="transparent")
        cab.grid(row=0, column=0, sticky="ew", padx=18, pady=16)
        self.label(cab, "Câmera ao vivo", 17, negrito=True).pack(side="left")
        self.status_camera = self.label(cab, "●  OFFLINE", 11, SUAVE, True)
        self.status_camera.pack(side="right")
        self.area_video = ctk.CTkLabel(camera, text="PYPROJECT\n\nInicie a câmera para verificar os EPIs", font=("Segoe UI", 18), text_color=SUAVE, fg_color="#060B14", corner_radius=12)
        self.area_video.grid(row=1, column=0, sticky="nsew", padx=16, pady=(0, 12))
        self.label(camera, "P1, P2… identificam pessoas apenas no quadro atual.", 10, SUAVE).grid(row=2, column=0, padx=16, pady=(0, 8))
        controles = ctk.CTkFrame(camera, fg_color="transparent")
        controles.grid(row=3, column=0, sticky="ew", padx=16, pady=(0, 16))
        controles.grid_columnconfigure((0, 1), weight=1)
        self.iniciar = ctk.CTkButton(controles, text="▶  Iniciar inspeção", height=44, fg_color=AZUL, hover_color="#326DDB", state="disabled", command=self.iniciar_camera)
        self.iniciar.grid(row=0, column=0, sticky="ew", padx=(0, 6))
        self.parar = ctk.CTkButton(controles, text="■  Encerrar", height=44, fg_color=CARTAO, hover_color=BORDA, state="disabled", command=self.parar_camera)
        self.parar.grid(row=0, column=1, sticky="ew", padx=(6, 0))

        direito = self.painel(corpo)
        direito.grid(row=3, column=1, sticky="nsew")
        self.label(direito, "Checklist de proteção", 19, negrito=True).pack(anchor="w", padx=20, pady=(18, 2))
        self.label(direito, "TODOS OS 6 EPIs SÃO OBRIGATÓRIOS", 10, SUAVE, True).pack(anchor="w", padx=20, pady=(0, 14))
        self.resultado = ctk.CTkLabel(direito, text="AGUARDANDO INSPEÇÃO", height=56, fg_color=CARTAO, corner_radius=10, font=("Segoe UI", 16, "bold"), text_color=SUAVE)
        self.resultado.pack(fill="x", padx=16)
        self.detalhe = self.label(direito, "Inicie o monitoramento para avaliar a cena.", 11, SUAVE, wraplength=315, justify="left")
        self.detalhe.pack(anchor="w", padx=20, pady=(8, 12))
        self.checks = {}
        for epi in EPIS:
            linha = ctk.CTkFrame(direito, fg_color=CARTAO, corner_radius=8)
            linha.pack(fill="x", padx=16, pady=3)
            self.label(linha, epi, 12).pack(side="left", padx=12, pady=9)
            status = self.label(linha, "—  Aguardando", 11, SUAVE, True)
            status.pack(side="right", padx=12)
            self.checks[epi] = status
        self.label(direito, "RESULTADO POR PESSOA", 10, SUAVE, True).pack(anchor="w", padx=20, pady=(15, 5))
        self.lista_pessoas = ctk.CTkTextbox(direito, height=85, fg_color=FUNDO, font=("Segoe UI", 11), wrap="word")
        self.lista_pessoas.pack(fill="both", expand=True, padx=16, pady=(0, 16))
        self.escrever(self.lista_pessoas, "Nenhuma avaliação disponível.")
        rodape = self.painel(corpo)
        rodape.grid(row=4, column=0, columnspan=2, sticky="ew", pady=(16, 0))
        self.label(rodape, "Histórico da inspeção", 13, negrito=True).pack(anchor="w", padx=16, pady=(10, 4))
        self.historico = ctk.CTkTextbox(rodape, height=72, fg_color="transparent", font=("Consolas", 11), text_color=SUAVE, wrap="word")
        self.historico.pack(fill="x", padx=12, pady=(0, 8))
        self.registrar_evento("Sistema inicializado. Aguardando modelo.")

    @staticmethod
    def escrever(widget, texto):
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("end", texto)
        widget.configure(state="disabled")

    def registrar_evento(self, texto):
        self.eventos.append(f"{datetime.now():%H:%M:%S}  {texto}")
        self.eventos = self.eventos[-100:]
        self.escrever(self.historico, "\n".join(self.eventos))
        self.historico.see("end")

    def carregar_modelo(self):
        caminho = PASTA_PROJETO / "best.pt"
        if not caminho.is_file():
            caminho = PASTA_PROJETO / "yolo11n.pt"
        try:
            if not caminho.is_file():
                raise FileNotFoundError("Adicione best.pt ou yolo11n.pt à pasta do projeto.")
            self.modelo = YOLO(str(caminho))
            self.classes_modelo = {normalizar(n) for n in self.modelo.names.values()}
            faltam = [e for e, aliases in EPIS.items() if not aliases & self.classes_modelo]
            texto = f"MODELO: {caminho.name}  •  "
            texto += "Não valida: " + ", ".join(faltam) if faltam else "Classes dos 6 EPIs disponíveis."
            self.modelo_label.configure(text=texto, text_color=AMARELO if faltam else VERDE)
            self.iniciar.configure(state="normal")
            self.registrar_evento(texto)
        except Exception as erro:
            self.modelo_label.configure(text=f"Falha ao carregar modelo: {erro}", text_color=VERMELHO)
            self.registrar_evento(f"Erro no modelo: {erro}")

    def iniciar_camera(self):
        if self.camera_ativa or self.modelo is None:
            return
        self.camera = cv2.VideoCapture(0)
        if not self.camera.isOpened():
            self.camera.release()
            self.camera = None
            messagebox.showerror("PYPROJECT | Câmera", "Não foi possível acessar a webcam.")
            return
        self.camera_ativa = True
        self.estado_anterior = None
        self.iniciar.configure(state="disabled")
        self.parar.configure(state="normal")
        self.status_camera.configure(text="●  AO VIVO", text_color=VERDE)
        self.registrar_evento("Inspeção iniciada.")
        self.atualizar_video()

    def mostrar_avaliacao(self, pessoas, presentes, suportados):
        total = len(pessoas)
        completas = all(suportados.values())
        liberadas = sum(len(e) == len(EPIS) for e in presentes) if completas else 0
        pendentes = total - liberadas
        for chave, valor in (("pessoas", total), ("liberadas", liberadas), ("pendentes", pendentes)):
            self.cards[chave].configure(text=str(valor))
        if not total:
            titulo, cor, fundo = "AGUARDANDO PESSOA", SUAVE, CARTAO
            detalhe = "Posicione a pessoa inteira no campo de visão da câmera."
        elif not completas:
            titulo, cor, fundo = "VALIDAÇÃO INDISPONÍVEL", AMARELO, "#362B1D"
            detalhe = "O modelo não reconhece todos os EPIs. Acesso não liberado."
        elif pendentes:
            titulo, cor, fundo = "ATENÇÃO • NÃO LIBERADO", VERMELHO, "#3B202D"
            detalhe = f"{pendentes} de {total} pessoa(s) com EPIs não confirmados."
        else:
            titulo, cor, fundo = "✓  OK — LIBERADO", VERDE, "#13382F"
            detalhe = "Os seis EPIs foram detectados em cada pessoa neste quadro."
        self.resultado.configure(text=titulo, text_color=cor, fg_color=fundo)
        self.detalhe.configure(text=detalhe)
        for epi, label in self.checks.items():
            quantidade = sum(epi in itens for itens in presentes)
            if not total:
                texto, cor_item = "—  Aguardando", SUAVE
            elif not suportados[epi]:
                texto, cor_item = "?  Sem suporte", AMARELO
            elif quantidade == total:
                texto, cor_item = f"✓  OK  {quantidade}/{total}", VERDE
            else:
                texto, cor_item = f"!  Não confirmado  {quantidade}/{total}", VERMELHO
            label.configure(text=texto, text_color=cor_item)
        linhas = []
        for i, itens in enumerate(presentes, 1):
            faltam = [e for e in EPIS if e not in itens and suportados[e]]
            sem_suporte = [e for e in EPIS if not suportados[e]]
            partes = []
            if faltam:
                partes.append("Não confirmado: " + ", ".join(faltam))
            if sem_suporte:
                partes.append("Sem suporte: " + ", ".join(sem_suporte))
            linhas.append(f"P{i}  •  " + (" | ".join(partes) if partes else "✓ OK — Liberado"))
        self.escrever(self.lista_pessoas, "\n\n".join(linhas) or "Nenhuma pessoa detectada.")
        # Registra mudanças de composição, sem somar um alerta a cada frame.
        estado = (total, tuple(sorted(tuple(sorted(e)) for e in presentes)))
        if estado != self.estado_anterior:
            if total and pendentes:
                self.quantidade_alertas += 1
                self.cards["alertas"].configure(text=str(self.quantidade_alertas))
            self.registrar_evento(titulo + (f" • {total} pessoa(s)." if total else ""))
            self.estado_anterior = estado

    def atualizar_video(self):
        self.after_id = None
        if not self.camera_ativa:
            return
        try:
            sucesso, frame = self.camera.read()
            if not sucesso:
                raise RuntimeError("Falha na captura da câmera.")
            resultado = self.modelo.predict(source=frame, conf=CONFIANCA_MINIMA, verbose=False)[0]
            deteccoes = []
            if resultado.boxes is not None:
                for classe, caixa in zip(resultado.boxes.cls.tolist(), resultado.boxes.xyxy.tolist()):
                    deteccoes.append((normalizar(resultado.names[int(classe)]), caixa))
            pessoas, presentes, suportados = avaliar_pessoas(deteccoes, self.classes_modelo)
            self.mostrar_avaliacao(pessoas, presentes, suportados)
            imagem = resultado.plot()
            for i, (_, caixa) in enumerate(pessoas):
                x1, y1, x2, y2 = map(int, caixa)
                ok = all(suportados.values()) and len(presentes[i]) == len(EPIS)
                cor = (164, 214, 66) if ok else (136, 120, 255)
                cv2.rectangle(imagem, (x1, y1), (x2, y2), cor, 2)
                cv2.putText(imagem, f"P{i + 1}: {'OK' if ok else 'PENDENTE'}", (x1, max(20, y1 - 10)), cv2.FONT_HERSHEY_SIMPLEX, 0.6, cor, 2)
            pil = Image.fromarray(cv2.cvtColor(imagem, cv2.COLOR_BGR2RGB))
            pil.thumbnail((max(100, self.area_video.winfo_width() - 8), max(100, self.area_video.winfo_height() - 8)))
            imagem_tk = ctk.CTkImage(light_image=pil, dark_image=pil, size=pil.size)
            self.area_video.configure(image=imagem_tk, text="")
            self.area_video.image = imagem_tk
        except Exception as erro:
            self.parar_camera()
            self.resultado.configure(text="FALHA NA INSPEÇÃO", text_color=VERMELHO, fg_color="#3B202D")
            self.detalhe.configure(text="Verificação interrompida. Nenhuma liberação ativa.")
            self.registrar_evento(f"Erro: {erro}")
            return
        self.after_id = self.after(40, self.atualizar_video)

    def parar_camera(self):
        self.camera_ativa = False
        if self.after_id is not None:
            self.after_cancel(self.after_id)
            self.after_id = None
        if self.camera is not None:
            self.camera.release()
            self.camera = None
        self.area_video.configure(image=None, text="PYPROJECT\n\nInspeção encerrada")
        self.area_video.image = None
        self.status_camera.configure(text="●  OFFLINE", text_color=SUAVE)
        self.iniciar.configure(state="normal" if self.modelo else "disabled")
        self.parar.configure(state="disabled")
        self.resultado.configure(text="INSPEÇÃO ENCERRADA", text_color=SUAVE, fg_color=CARTAO)
        self.detalhe.configure(text="Inicie a câmera para uma nova verificação.")
        for label in self.checks.values():
            label.configure(text="—  Aguardando", text_color=SUAVE)
        for chave in ("pessoas", "liberadas", "pendentes"):
            self.cards[chave].configure(text="0")
        self.escrever(self.lista_pessoas, "Nenhuma avaliação ativa.")
        self.registrar_evento("Inspeção encerrada.")

    def fechar(self):
        self.parar_camera()
        self.destroy()


if __name__ == "__main__":
    Aplicacao().mainloop()
